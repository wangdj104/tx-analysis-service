# Existing MySQL database. Do not add this file with real secrets to Git.
DB_URL=jdbc:mysql://host.docker.internal:3306/txdata?useUnicode=true&characterEncoding=utf-8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
DB_USERNAME=replace-with-database-user
DB_PASSWORD=replace-with-database-password

# Generate a long random value and keep it stable across application restarts.
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRATION_MS=86400000

# Use the final HTTPS origin when a domain and certificate are configured.
CORS_ALLOWED_ORIGINS=http://150.158.160.166:8080
WEB_PORT=8080

AUDIT_CAPTURE_CLIENT_IP=true
DEEPSEEK_API_KEY=
BAILIAN_API_KEY=
OCR_API_KEY=
LANGFLOW_ENABLED=false
