# Existing MySQL database. Replace the hostname/database; never commit real secrets.
# The hostname must match the server certificate and its CA must be trusted by Java.
# Configure the deployment truststore when using a private CA; do not disable TLS.
DB_URL=jdbc:mysql://db.example.com:3306/family_health?useUnicode=true&characterEncoding=utf-8&sslMode=VERIFY_IDENTITY&allowPublicKeyRetrieval=false&serverTimezone=Asia/Shanghai
DB_USERNAME=replace-with-database-user
DB_PASSWORD=replace-with-database-password

# Generate a long random value and keep it stable across application restarts.
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRATION_MS=86400000

# Enable collaboration and execution reports only after migration and acceptance.
CARE_PLAN_ENABLED=false
# Optional readable font path INSIDE the API container; blank uses installed fonts.
# A host font needs a read-only mount. See docs/OFFLINE_DEPLOYMENT.md.
REPORT_PDF_FONT_PATH=

# Replace with the final HTTPS origin. Terminate TLS at your host reverse proxy.
CORS_ALLOWED_ORIGINS=https://health.example.com
# Host binding consumed by Compose; keep the HTTP upstream private behind that proxy.
WEB_PORT=127.0.0.1:8080

AUDIT_CAPTURE_CLIENT_IP=true
DEEPSEEK_API_KEY=
BAILIAN_API_KEY=
OCR_API_KEY=
LANGFLOW_ENABLED=false
