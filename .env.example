# Copy to .env for local Docker Compose, then set fresh secrets below.
# This template contains no working passwords or API keys.
MYSQL_DATABASE=family_health
MYSQL_USER=family_health
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Used by local Maven/IDE runs. Docker Compose sets DB_URL to its db service.
# Maven does NOT automatically load .env: configure these as process/IDE environment variables.
DB_URL='jdbc:mysql://127.0.0.1:3306/family_health?useUnicode=true&characterEncoding=utf-8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai'
DB_USERNAME=family_health
DB_PASSWORD=
JWT_SECRET=
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://localhost:8080
SERVER_PORT=8082
API_DOCS_ENABLED=false
AUDIT_CAPTURE_CLIENT_IP=false

# Only for first-run local Maven/IDE setup on a database without an administrator.
# Choose a unique username and a password of at least 12 characters; disable after setup.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# Optional providers. Keep secrets server-side and out of source control.
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEEPSEEK_API_MODEL=deepseek-v3
BAILIAN_API_KEY=
OCR_API_KEY=
OCR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OCR_MODEL=qwen-vl-max
LANGFLOW_ENABLED=false
LANGFLOW_BASE_URL=http://host.docker.internal:7860/api
LANGFLOW_API_KEY=
LANGFLOW_DEFAULT_FLOW_ID=
