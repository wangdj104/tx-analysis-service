FROM node:20-alpine AS english-build
WORKDIR /workspace/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM node:20-alpine AS chinese-build
WORKDIR /workspace/frontend
COPY cn/frontend/package.json cn/frontend/package-lock.json ./
RUN npm ci
COPY cn/frontend/ ./
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=english-build /workspace/frontend/dist/ /usr/share/nginx/html/
COPY --from=chinese-build /workspace/frontend/dist/ /usr/share/nginx/html/cn/
COPY demo/ /usr/share/nginx/html/demo/
COPY cn/demo/ /usr/share/nginx/html/cn/demo/
COPY deploy/nginx.bilingual.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
